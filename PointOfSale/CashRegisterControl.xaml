<UserControl x:Class="TheFlyingSaucer.PointOfSale.CashRegisterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TheFlyingSaucer.PointOfSale"
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- Bill -->
            <TextBlock Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold">Bill</TextBlock>
            <Button Grid.Column="1" Grid.Row="2" Height="20" Width="28" FontSize="10">$100</Button>
            <Button Grid.Column="1" Grid.Row="3" Height="20" Width="28" FontSize="10">$50</Button>
            <Button Grid.Column="1" Grid.Row="4" Height="20" Width="28" FontSize="10">$20</Button>
            <Button Grid.Column="1" Grid.Row="5" Height="20" Width="28" FontSize="10">$10</Button>
            <Button Grid.Column="1" Grid.Row="6" Height="20" Width="28" FontSize="10">$5</Button>
            <Button Grid.Column="1" Grid.Row="7" Height="20" Width="28" FontSize="10">$2</Button>
            <Button Grid.Column="1" Grid.Row="8" Height="20" Width="28" FontSize="10">$1</Button>
            <TextBlock Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold">From Customer</TextBlock>
            <local:CountBox Grid.Column="2" Grid.Row="2" Count="{Binding Path=HundredBillCount}" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="2" Grid.Row="3" Count="{Binding Path=FiftyBillCount}" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="2" Grid.Row="4" Count="{Binding Path=TwentyBillCount}" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="2" Grid.Row="5" Count="{Binding Path=TenBillCount}" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="2" Grid.Row="6" Count="{Binding Path=FiveBillCount}" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="2" Grid.Row="7" Count="{Binding Path=TwoBillCount}" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="2" Grid.Row="8" Count="{Binding Path=OneBillCount}" FontSize="30"></local:CountBox>
            <TextBlock Grid.Column="3" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold">Change</TextBlock>
            <TextBox Text="{Binding Path=HundredBillChange}" IsReadOnly="True" Grid.Column="3" Grid.Row="2" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=FiftyBillChange}" IsReadOnly="True" Grid.Column="3" Grid.Row="3" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=TwentyBillChange}" IsReadOnly="True" Grid.Column="3" Grid.Row="4" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=TenBillChange}" IsReadOnly="True" Grid.Column="3" Grid.Row="5" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=FiveBillChange}" IsReadOnly="True" Grid.Column="3" Grid.Row="6" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=TwoBillChange}" IsReadOnly="True" Grid.Column="3" Grid.Row="7" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=OneBillChange}" IsReadOnly="True" Grid.Column="3" Grid.Row="8" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <!-- coin -->
            <TextBlock Grid.Column="5" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold">Coin</TextBlock>
            <Label Grid.Column="5" Grid.Row="3" Height="40" Width="55" FontSize="15">$1</Label>
            <Label Grid.Column="5" Grid.Row="4" Height="40" Width="55" FontSize="15">50¢</Label>
            <Label Grid.Column="5" Grid.Row="5" Height="40" Width="55" FontSize="15">25¢</Label>
            <Label Grid.Column="5" Grid.Row="6" Height="40" Width="55" FontSize="15">10¢</Label>
            <Label Grid.Column="5" Grid.Row="7" Height="40" Width="55" FontSize="15">5¢</Label>
            <Label Grid.Column="5" Grid.Row="8" Height="40" Width="55" FontSize="15">1¢</Label>
            <TextBlock Grid.Column="6" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold">From Customer</TextBlock>
            <local:CountBox Grid.Column="6" Grid.Row="3" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="6" Grid.Row="4" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="6" Grid.Row="5" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="6" Grid.Row="6" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="6" Grid.Row="7" FontSize="30"></local:CountBox>
            <local:CountBox Grid.Column="6" Grid.Row="8" FontSize="30"></local:CountBox>
            <TextBlock Grid.Column="7" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold">Change</TextBlock>
            <TextBox Text="{Binding Path=DollarCoinChange}" IsReadOnly="True" Grid.Column="7" Grid.Row="3" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=FiftyCoinChange}" IsReadOnly="True" Grid.Column="7" Grid.Row="4" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=QuarterChange}" IsReadOnly="True" Grid.Column="7" Grid.Row="5" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=DimeChange}" IsReadOnly="True" Grid.Column="7" Grid.Row="6" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=NickelChange}" IsReadOnly="True" Grid.Column="7" Grid.Row="7" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <TextBox Text="{Binding Path=PennyChange}" IsReadOnly="True" Grid.Column="7" Grid.Row="8" Height="40" Width="60" FontSize="25" TextAlignment="Center"/>
            <!-- button -->
            <Grid Grid.Column="7" Grid.Row="1">
                <Button Click="Return_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom">Return to</TextBlock>
                        <TextBlock Grid.Row="1" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top">Order</TextBlock>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- Labels -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Label FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom">Total</Label>
                </Grid>
                <Grid Grid.Row="1">
                    <Label FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top">Sale</Label>
                </Grid>
            </Grid>
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Label FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom">Amount</Label>
                </Grid>
                <Grid Grid.Row="1">
                    <Label FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top">Due</Label>
                </Grid>
            </Grid>
            <Grid Grid.Column="7">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Label FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom">Change</Label>
                </Grid>
                <Grid Grid.Row="1">
                    <Label FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top">Owed</Label>
                </Grid>
            </Grid>
            <!-- Display Blocks -->
            <Grid Grid.Column="2">
                <TextBlock Text="{Binding Path=Total}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"/>
            </Grid>
            <Grid Grid.Column="5">
                <TextBlock Text="{Binding Path=AmountDue}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"/>
            </Grid>
            <Grid Grid.Column="8">
                <TextBlock Text="{Binding Path=Change}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"/>
            </Grid>
            <!-- Button -->
            <Grid Grid.Column="10">
                <Button Click="Finalize_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom">Finalize</TextBlock>
                        <TextBlock Grid.Row="1" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top">Sale</TextBlock>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
