<UserControl x:Class="TheFlyingSaucer.PointOfSale.EvisceratedEggsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TheFlyingSaucer.PointOfSale"
             xmlns:local2="clr-namespace:TheFlyingSaucer.Data;assembly=TheFlyingSaucer.Data"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="600">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="eggstyle" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local2:EggStyle"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Path=Name}" FontSize="30" HorizontalAlignment="Center"/>
        <ListBox Grid.Row="1">
            <ListBoxItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0">Egg Count:</TextBlock>
                    <local:CountBox Grid.Column="1" Count="{Binding Path=Count}"/>
                </Grid>
            </ListBoxItem>
            <ListBoxItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0">Egg Style:</TextBlock>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource eggstyle}}" SelectedItem="{Binding Path=Style, Mode=TwoWay}"/>
                </Grid>
            </ListBoxItem>
        </ListBox>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="30">Calories:</TextBlock>
            <TextBlock Grid.Column="1" FontSize="30" Text="{Binding Path=Calories}"/>
        </Grid>
    </Grid>
</UserControl>
