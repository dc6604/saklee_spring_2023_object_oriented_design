<Window x:Class="TheFlyingSaucer.PointOfSale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TheFlyingSaucer.PointOfSale"
        mc:Ignorable="d"
        Title="The Flying Saucer Point of Sale" Height="720" Width="1080">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="640"/>
        </Grid.RowDefinitions>
        <Border Name="Bd" Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="650"/>
                    <ColumnDefinition Width="430"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="520"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Border Name="Brdr">
                            <local:MenuItemSelectionControl x:Name="MSC"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="60" Width="180" FontSize="20" Content="Cancel Order" Name="CancelOrderBtn" Click="CancelOrder_Click"/>
                        <Button Grid.Column="1" Height="60" Width="180" FontSize="20" Content="Back to Menu" Name="BackToMenuBtn" Click="BackToMenu_Click" IsEnabled="False"/>
                        <Button Grid.Column="2" Height="60" Width="180" FontSize="20" Content="Complete Order" Name="CompleteOrderBtn" Click="CompleteOrder_Click"/>
                    </Grid>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="640"/>
                    </Grid.RowDefinitions>
                    <local:OrderSummaryControl x:Name="OSC" ButtonBase.Click="OSC_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
